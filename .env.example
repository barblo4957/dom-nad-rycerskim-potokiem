# Ustawić na "true" tylko dla środowiska Preview w Vercel —
# pokazuje właścicielce znaczniki "do potwierdzenia" (Note.svelte).
# Na Production zostawić "false": notatki i pola bez potwierdzonej
# wartości znikają ze strony.
PUBLIC_SHOW_NOTES=false

# Docelowa domena produkcyjna (bez ukośnika na końcu), np. https://domnadrycerskimpotokiem.pl
# Wymagane dla canonical, og:url i <loc> w sitemap.xml — bez tej zmiennej
# te pola są pomijane (nieprawidłowe byłoby wpisanie na sztywno niepotwierdzonej domeny).
PUBLIC_SITE_URL=
